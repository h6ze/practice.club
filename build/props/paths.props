<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="UserMacros">
    <PracticeRoot>$(MSBuildThisFileDirectory)..\..\</PracticeRoot>
    <PracticeCode>$(PracticeRoot)code\</PracticeCode>
    <PracticeVendor>$(PracticeRoot)vendor\</PracticeVendor>
    <VcpkgInclude>$(USERPROFILE)\vcpkg\installed\x64-windows\include</VcpkgInclude>
  </PropertyGroup>

  <PropertyGroup>
    <OutDir>$(PracticeRoot)bin\$(Configuration)\</OutDir>
    <IntDir>$(PracticeRoot)obj\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>

</Project>
